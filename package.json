{
  "name": "proxmox-cli",
  "version": "0.0.7",
  "description": "CLI for managing Proxmox VMs",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "bin": {
    "proxmox": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "cli:dev": "bun --hot bin/cli.ts",
    "cli": "bun bin/cli.ts",
    "build": "bun run clean && bun build --production --target=node bin/cli.ts --outdir dist",
    "clean": "rm -rf dist/*",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "local:install": "bun run build && npm link",
    "local:uninstall": "npm unlink -g proxmox-cli",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@inquirer/prompts": "8.4.1",
    "@t3-oss/env-core": "0.13.11",
    "@types/bun": "1.4.4",
    "@types/lodash": "4.17.24",
    "chalk": "5.6.2",
    "cli-table3": "0.6.5",
    "commander": "13.1.0",
    "dotenv": "17.4.1",
    "lodash": "4.18.1",
    "ora": "9.3.0",
    "typescript": "5.9.3",
    "zod": "4.6.7",
    "zx": "8.8.5"
  }
}
